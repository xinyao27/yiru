{
  "name": "@yiru/workspace",
  "version": "0.0.24",
  "private": true,
  "description": "Yiru monorepo workspace",
  "homepage": "https://github.com/xinyao27/yiru#readme",
  "bugs": {
    "url": "https://github.com/xinyao27/yiru/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyao27/yiru.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "type": "module",
  "scripts": {
    "dev": "vp run build && node scripts/start-development.mjs",
    "dev:desktop": "vp run yiru#dev",
    "dev:landing": "vp run yiru-landing#dev",
    "dev:mobile": "vp run yiru-mobile#dev",
    "start": "vp run yiru#start",
    "build": "vp run yiru#build",
    "build:landing": "vp run yiru-landing#build",
    "build:release": "vp run yiru#build:release",
    "build:unpack": "vp run yiru#build:unpack",
    "deploy:landing": "vp run yiru-landing#deploy",
    "verify:workspace-contracts": "node scripts/check-source-path-references.mjs && node scripts/check-import-path-policy.mjs && node scripts/check-max-lines-ratchet.mjs && vp run verify:rpc-access-inventory && node scripts/generate-bundled-skill-guides.mjs --check && node scripts/generate-skill-bundle-manifest.mjs",
    "analyze:preload-contract-gaps": "node scripts/compare-preload-contract-inputs.mjs",
    "check:source-path-references": "node scripts/check-source-path-references.mjs",
    "check:import-path-policy": "node scripts/check-import-path-policy.mjs",
    "check:max-lines-ratchet": "node scripts/check-max-lines-ratchet.mjs",
    "verify:rpc-access-inventory": "node scripts/rpc-access-inventory/generate.mjs --check",
    "generate:rpc-access-inventory": "node scripts/rpc-access-inventory/generate.mjs --write",
    "verify:bundled-skill-guides": "node scripts/generate-bundled-skill-guides.mjs --check",
    "verify:skill-bundle-manifest": "node scripts/generate-skill-bundle-manifest.mjs",
    "typecheck": "vp run --cache -r typecheck",
    "check": "vp check --fix && vp run typecheck && vp run verify:workspace-contracts && vp run yiru#verify:repository-contracts && vp run yiru-mobile#verify:repository-contracts",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "fmt": "vp fmt",
    "up": "taze major -Ir",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:desktop",
    "typescript-api": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@11.15.0"
}
