{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Why: renaming a Worker creates a new Cloudflare Worker. After this PR merges,
  // do not deploy until the yiru.ai and www.yiru.ai custom domains have been
  // manually migrated from the old Worker following the cutover runbook.
  "name": "yiru-web",
  "main": "worker/site.ts",
  "compatibility_date": "2026-08-01",
  // Why: the yiru.ai zone lives in this account, and pinning it keeps a CI
  // deploy from landing wherever the API token's default account happens to be.
  "account_id": "d0a04266246b5b2d59b897c8dd088776",
  "routes": [
    { "pattern": "yiru.ai", "custom_domain": true },
    { "pattern": "www.yiru.ai", "custom_domain": true },
    { "pattern": "app.yiru.ai", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONNECT_GRANTS", "class_name": "ConnectGrantObject" },
      { "name": "CONNECT_MACHINES", "class_name": "ConnectMachineObject" }
    ]
  },
  "ratelimits": [
    {
      "name": "CONNECT_BROWSER_RATE_LIMIT",
      "namespace_id": "7312041",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "CONNECT_NETWORK_RATE_LIMIT",
      "namespace_id": "7312042",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConnectGrantObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ConnectMachineObject"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Why: the site has exactly one route, so an SPA fallback did not serve a
    // deep link — it answered 200 with the homepage for every wrong URL, which
    // reads as a soft 404 to a crawler and as a broken link to a visitor. The
    // paths the product actually ships are redirected in worker/site.ts; anything
    // else is genuinely missing and says so with a 404 status.
    "not_found_handling": "404-page",
    // Why: the www redirect in worker/site.ts only fires if the Worker runs
    // before the asset router, which short-circuits every matching path.
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  }
}
