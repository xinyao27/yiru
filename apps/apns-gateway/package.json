{
  "name": "@yiru/apns-gateway",
  "version": "0.0.1",
  "private": true,
  "description": "Stateless APNs forwarding gateway for Yiru Mobile",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "vp run typecheck && wrangler deploy",
    "lint": "vp lint src",
    "typecheck": "tsc --noEmit",
    "types:generate": "node scripts/generate-bindings.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
