{
  "name": "yiru-landing",
  "version": "0.0.0",
  "private": true,
  "description": "Yiru landing page",
  "homepage": "https://github.com/xinyao27/yiru#readme",
  "bugs": {
    "url": "https://github.com/xinyao27/yiru/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyao27/yiru.git",
    "directory": "apps/landing"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "preview": "vp preview",
    "build:workspace-deps": "vp run --filter '{.}^...' build",
    "build": "vp run build:workspace-deps && vp build && node scripts/prerender.mjs",
    "typecheck": "vp run build:workspace-deps && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "vp run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:",
    "@yiru/workbench-model": "workspace:*",
    "cnfast": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "thinking-orbs": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:desktop",
    "wrangler": "catalog:"
  }
}
