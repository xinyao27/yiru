{
  "expo": {
    "name": "Yiru",
    "slug": "yiru-mobile",
    "version": "0.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yiru",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xinyao27.yiru.mobile",
      "buildNumber": "1",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Yiru connects to the desktop app on your local network.",
        "NSPhotoLibraryUsageDescription": "Allow Yiru to attach photos from your library to a terminal session on your paired desktop.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "fd7a:115c:a1e0::/48": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#1687EC",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "allowBackup": false,
      "package": "com.xinyao27.yiru.mobile",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "./plugins/android-respect-rotation-lock.cjs",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1687EC",
          "defaultChannel": "yiru-desktop"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yiru to take photos and scan pairing codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Yiru to take photos for agent and terminal attachments.",
          "photosPermission": "Allow Yiru to attach photos from your library to an agent or terminal session on your paired desktop."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "usePrecompiledModules": false
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.xinyao27.yiru.mobile",
          "widgets": [
            {
              "name": "ProviderUsageWidget",
              "displayName": "ChatGPT Usage",
              "description": "Shows remaining ChatGPT subscription quota.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall"],
              "configuration": {
                "title": "Provider",
                "description": "Choose the subscription to show.",
                "parameters": {
                  "provider": {
                    "title": "Provider",
                    "type": "enum",
                    "values": [
                      { "name": "ChatGPT", "value": "codex" },
                      { "name": "Claude", "value": "claude" }
                    ],
                    "default": "codex"
                  }
                }
              }
            },
            {
              "name": "ClaudeUsageWidget",
              "displayName": "Claude Usage",
              "description": "Shows remaining Claude subscription quota.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall"],
              "configuration": {
                "title": "Provider",
                "description": "Choose the subscription to show.",
                "parameters": {
                  "provider": {
                    "title": "Provider",
                    "type": "enum",
                    "values": [
                      { "name": "ChatGPT", "value": "codex" },
                      { "name": "Claude", "value": "claude" }
                    ],
                    "default": "claude"
                  }
                }
              }
            },
            {
              "name": "WorkspaceStatusWidget",
              "displayName": "Running Workspaces",
              "description": "Shows the status of workspaces that are currently running.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall"]
            },
            {
              "name": "TokenUsageWidget",
              "displayName": "Token Usage",
              "description": "Shows cumulative token usage for today and this week.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall"]
            }
          ]
        }
      ]
    ]
  }
}
