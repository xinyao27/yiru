nonisolated enum MobileClientEventWire: Decodable, Sendable {
    case ready(subscriptionId: String)
    case reposChanged
    case worktreesChanged(repoId: String)
    case ignored
    case end

    private enum EventType: String, Decodable {
        case ready
        case reposChanged
        case worktreesChanged
        case activateWorktree
        case worktreeHeadIdentitiesChanged
        case end
    }
    private enum CodingKeys: String, CodingKey {
        case type
        case subscriptionId
        case repoId
    }

    init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        switch try container.decode(EventType.self, forKey: .type) {
        case .ready:
            self = .ready(
                subscriptionId: try container.decode(String.self, forKey: .subscriptionId))
        case .reposChanged:
            self = .reposChanged
        case .worktreesChanged:
            self = .worktreesChanged(repoId: try container.decode(String.self, forKey: .repoId))
        case .activateWorktree, .worktreeHeadIdentitiesChanged:
            self = .ignored
        case .end:
            self = .end
        }
    }
}

