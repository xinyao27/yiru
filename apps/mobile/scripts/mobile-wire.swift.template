nonisolated enum MobileNotificationEventWire: Decodable, Sendable {
    case notification(
        source: String, title: String, body: String, worktreeId: String?, notificationId: String?,
        notificationSeq: Int64?)
    case dismiss(notificationId: String, notificationSeq: Int64?)
    case ready(subscriptionId: String)
    case end

    private enum EventType: String, Decodable {
        case notification
        case dismiss
        case ready
        case end
    }
    private enum CodingKeys: String, CodingKey {
        case type
        case source
        case title
        case body
        case worktreeId
        case notificationId
        case notificationSeq
        case subscriptionId
    }

    init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        switch try container.decode(EventType.self, forKey: .type) {
        case .notification:
            self = .notification(
                source: try container.decode(String.self, forKey: .source),
                title: try container.decode(String.self, forKey: .title),
                body: try container.decode(String.self, forKey: .body),
                worktreeId: try container.decodeIfPresent(String.self, forKey: .worktreeId),
                notificationId: try container.decodeIfPresent(String.self, forKey: .notificationId),
                notificationSeq: try container.decodeIfPresent(Int64.self, forKey: .notificationSeq)
            )
        case .dismiss:
            self = .dismiss(
                notificationId: try container.decode(String.self, forKey: .notificationId),
                notificationSeq: try container.decodeIfPresent(Int64.self, forKey: .notificationSeq)
            )
        case .ready:
            self = .ready(
                subscriptionId: try container.decode(String.self, forKey: .subscriptionId))
        case .end: self = .end
        }
    }
}

