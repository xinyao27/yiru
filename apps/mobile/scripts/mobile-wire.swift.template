nonisolated enum MobileRepoIconWire: Decodable, Equatable, Sendable {
    case lucide(name: String)
    case emoji(String)
    case image(src: String, source: MobileRepoIconImageSourceWire, label: String?)

    private enum IconType: String, Decodable {
        case lucide
        case emoji
        case image
    }

    private enum CodingKeys: String, CodingKey {
        case type
        case name
        case emoji
        case src
        case source
        case label
    }

    init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        switch try container.decode(IconType.self, forKey: .type) {
        case .lucide:
            self = .lucide(name: try container.decode(String.self, forKey: .name))
        case .emoji:
            self = .emoji(try container.decode(String.self, forKey: .emoji))
        case .image:
            self = .image(
                src: try container.decode(String.self, forKey: .src),
                source: try container.decode(MobileRepoIconImageSourceWire.self, forKey: .source),
                label: try container.decodeIfPresent(String.self, forKey: .label)
            )
        }
    }
}

