{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/env.d.ts",
    "../src/renderer/**/*",
    "../src/renderer/**/*.tsx",
    "../src/preload/api-types.ts",
    "../src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "~renderer/*": ["../src/renderer/*"],
      "~shared/*": ["../src/shared/*"],
      "~main/*": ["../src/main/*"],
      "~preload/*": ["../src/preload/*"]
    }
  }
}
