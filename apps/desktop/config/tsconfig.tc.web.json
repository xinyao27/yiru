{
  "extends": "./tsconfig.web.json",
  "include": [
    "../src/renderer/env.d.ts",
    "../src/renderer/**/*",
    "../src/renderer/**/*.tsx",
    "../src/preload/api-types.ts",
    "../../../packages/shared/src/**/*",
    "../src/main/worktree/branch-name.ts",
    "../src/main/worktree/logic.ts",
    "../src/main/worktree/linked-review-metadata.ts",
    "../src/main/worktree/metadata-merge.ts",
    "../src/main/worktree/path-comparison.ts",
    "../src/main/wsl.ts"
  ],
  "compilerOptions": {
    "paths": {
      "~renderer/*": ["../src/renderer/*"],
      "~shared/*": ["../../../packages/shared/src/*"],
      "~main/*": ["../src/main/*"],
      "~preload/*": ["../src/preload/*"]
    }
  }
}
