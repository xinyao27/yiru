{
  "name": "@yiru/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Yiru cross-process domain types and pure logic shared by client, desktop main/preload, CLI, and relay",
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "react-native": "./src/*.ts",
      "browser": "./src/*.ts",
      "development": "./src/*.ts",
      "import": "./dist/esm/*.mjs",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-esm.mjs",
    "fmt": "vp fmt .",
    "lint": "vp lint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@yiru/mobile-relay-protocol": "workspace:*",
    "@yiru/runtime-protocol": "workspace:*",
    "@yiru/workbench-model": "workspace:*",
    "tweetnacl": "catalog:",
    "ws": "catalog:desktop",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@xterm/xterm": "catalog:desktop",
    "typescript": "catalog:desktop",
    "vite": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "//": "Why: 425 source modules make explicit subpath enumeration impractical, so one wildcard preserves every module boundary."
}
