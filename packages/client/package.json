{
  "name": "@yiru/client",
  "version": "0.0.1",
  "private": true,
  "description": "Yiru source-only React client shared by Electron and browser hosts",
  "type": "module",
  "sideEffects": [
    "./src/assets/main.css"
  ],
  "exports": {
    "./web-index.html": "./src/web-index.html",
    "./web-bootstrap": "./src/web/bootstrap.ts",
    "./styles": "./src/assets/main.css",
    "./paraglide/messages": {
      "types": "./generated/paraglide/messages.d.ts",
      "default": "./generated/paraglide/messages.js"
    },
    "./vite": "./vite.ts"
  },
  "scripts": {
    "build": "vp run generate:i18n",
    "fmt": "vp fmt .",
    "lint": "vp lint . --fix",
    "generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./generated/paraglide --emit-ts-declarations --output-structure locale-modules",
    "typecheck": "vp run generate:i18n && tsc --noEmit",
    "verify:design-token-budget": "node scripts/check-design-token-budget.mjs",
    "verify:ui-style-drift": "node scripts/check-ui-style-drift.mjs"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@floating-ui/dom": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@xterm/addon-serialize": "catalog:",
    "@yiru/editor-themes": "workspace:*",
    "@yiru/mobile-relay-protocol": "workspace:*",
    "@yiru/runtime-protocol": "workspace:*",
    "@yiru/shared": "workspace:*",
    "@yiru/workbench-model": "workspace:*",
    "cnfast": "catalog:",
    "qrcode": "catalog:",
    "thinking-orbs": "catalog:",
    "tweetnacl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-i18next": "catalog:",
    "@legendapp/list": "catalog:",
    "@pierre/diffs": "catalog:",
    "@pierre/trees": "catalog:",
    "@sanity/diff-match-patch": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-code": "catalog:",
    "@tiptap/extension-code-block-lowlight": "catalog:",
    "@tiptap/extension-details": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-mathematics": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-table-cell": "catalog:",
    "@tiptap/extension-table-header": "catalog:",
    "@tiptap/extension-table-row": "catalog:",
    "@tiptap/extension-task-item": "catalog:",
    "@tiptap/extension-task-list": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:desktop",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-ligatures": "catalog:",
    "@xterm/addon-search": "catalog:",
    "@xterm/addon-unicode11": "catalog:desktop",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/addon-webgl": "catalog:desktop",
    "@xterm/xterm": "catalog:desktop",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "dompurify": "catalog:",
    "emoji-picker-react": "catalog:",
    "html-to-image": "catalog:",
    "katex": "catalog:",
    "lowlight": "catalog:",
    "marked": "catalog:",
    "mermaid": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "pdfjs-dist": "catalog:",
    "react": "catalog:desktop",
    "react-colorful": "catalog:",
    "react-dom": "catalog:desktop",
    "react-grab": "catalog:",
    "react-markdown": "catalog:",
    "rehype-highlight": "catalog:",
    "rehype-katex": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-sanitize": "catalog:",
    "rehype-slug": "catalog:",
    "remark-breaks": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "remark-parse": "catalog:",
    "shadcn": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:desktop",
    "unified": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zustand": "catalog:desktop"
  },
  "packageManager": "pnpm@11.15.0",
  "//": "Why: Electron and browser consumers bundle this TS/TSX source directly; wildcard exports cannot model TSX plus CSS, fonts, and ?url assets, so the supported host entrypoints stay explicit and there is deliberately no dist build.",
  "reactDoctor": {
    "rules": {
      "react-doctor/js-combine-iterations": "off"
    }
  }
}
